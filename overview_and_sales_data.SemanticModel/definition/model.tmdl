model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["orders_info","classicmodels payments","classicmodels customers"]

ref table orders_info
ref table 'classicmodels payments'
ref table 'classicmodels customers'
ref table 'Dim Date'
ref table _Measures

ref cultureInfo en-US


table 'Dim Date'
	lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1001
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1002
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1003
		summarizeBy: none
		sourceColumn: [Year]

	column Quarter
		dataType: string
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1004
		summarizeBy: none
		sourceColumn: [Quarter]

	column Year-Quarter
		dataType: string
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1005
		summarizeBy: none
		sourceColumn: [Year-Quarter]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1006
		summarizeBy: none
		sourceColumn: [Month Number]

	column Month
		dataType: string
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1007
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	column Year-Month
		dataType: string
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1008
		summarizeBy: none
		sourceColumn: [Year-Month]
		sortByColumn: 'Year-Month Sort'

	column 'Year-Month Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5d1c1b0e-7a41-4a6e-9a3a-0c1f2e9b1009
		summarizeBy: none
		sourceColumn: [Year-Month Sort]

	partition 'Dim Date' = calculated
		mode: import
		source =
				VAR MinD = DATE ( YEAR ( MIN ( orders_info[orderDate] ) ), 1, 1 )
				VAR MaxD = DATE ( YEAR ( MAX ( 'classicmodels payments'[paymentDate] ) ), 12, 31 )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinD, MaxD ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Year-Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMM" ),
				    "Year-Month", FORMAT ( [Date], "yyyy-MM" ),
				    "Year-Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)

	annotation PBI_ResultType = Table


	partition orders_info = m
		mode: import
		source =
				let
				    Source = MySQL.Database("3.252.97.149", "classicmodels", [ReturnSingleDatabase=true, Query="WITH order_summary AS (#(lf)    SELECT#(lf)        o.orderNumber,#(lf)        o.orderDate,#(lf)        o.shippedDate,#(lf)        o.requiredDate,#(lf)        o.status,#(lf)        o.customerNumber,#(lf)        SUM(od.quantityOrdered * od.priceEach) AS totalSales,#(lf)        SUM(od.quantityOrdered * p.buyPrice) AS totalCost,#(lf)        SUM((od.quantityOrdered * od.priceEach) - (od.quantityOrdered * p.buyPrice)) AS totalProfit#(lf)    FROM#(lf)        orders o#(lf)        INNER JOIN orderdetails od ON o.orderNumber = od.orderNumber#(lf)        INNER JOIN products p ON od.productCode = p.productCode#(lf)    GROUP BY#(lf)        o.orderNumber, o.orderDate, o.shippedDate, o.requiredDate, o.status, o.customerNumber#(lf))#(lf)SELECT#(lf)    os.orderNumber,#(lf)    os.orderDate,#(lf)    os.shippedDate,#(lf)    os.requiredDate,#(lf)    os.status,#(lf)    os.customerNumber,#(lf)    c.customerName,#(lf)    c.country,#(lf)    e.employeeNumber AS salesRepEmployeeNumber,#(lf)    CONCAT(e.firstName, ' ', e.lastName) AS salesRep,#(lf)    os.totalSales,#(lf)    os.totalCost,#(lf)    os.totalProfit#(lf)FROM#(lf)    order_summary os#(lf)    INNER JOIN customers c ON os.customerNumber = c.customerNumber#(lf)    LEFT JOIN employees e ON c.salesRepEmployeeNumber = e.employeeNumber;#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation


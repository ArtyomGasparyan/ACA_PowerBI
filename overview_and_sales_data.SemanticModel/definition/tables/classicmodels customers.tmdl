		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Static (all-time) balance segment per customer, used for slicers and legends.
	column 'Balance Segment' =
			VAR Bal = [Outstanding Balance]
			RETURN SWITCH ( TRUE (), Bal > 0, "In Debt", Bal < 0, "Deposit", "Settled" )
		dataType: string
		lineageTag: 7a2d1c00-0000-4000-8000-000000000001
		summarizeBy: none

	/// Static (all-time) credit utilization band per customer, used for slicers and charts.
	column 'Utilization Segment' =
			VAR Debt = MAX ( [Outstanding Balance], 0 )
			VAR Limit = [creditLimit]
			VAR U = DIVIDE ( Debt, Limit )
			RETURN SWITCH ( TRUE (), ISBLANK ( U ), "No Limit", U >= 1, "Over Limit", U >= 0.8, "High (80-100%)", U >= 0.5, "Medium (50-80%)", "Low (<50%)" )
		dataType: string
		lineageTag: 7a2d1c00-0000-4000-8000-000000000002
		summarizeBy: none
		sortByColumn: 'Utilization Segment Order'

	column 'Utilization Segment Order' =
			VAR Debt = MAX ( [Outstanding Balance], 0 )
			VAR U = DIVIDE ( Debt, [creditLimit] )
			RETURN SWITCH ( TRUE (), ISBLANK ( U ), 5, U >= 1, 4, U >= 0.8, 3, U >= 0.5, 2, 1 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7a2d1c00-0000-4000-8000-000000000003
		summarizeBy: none

